NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Copiar la cadena de conexión de Supabase > Connect > Session pooler.
# Solo en el servidor API; jamás usar NEXT_PUBLIC_ para credenciales.
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres
DATABASE_SSL=true
# Opcional: certificado raiz descargado en Supabase > Database Settings > SSL Configuration.
# Usa una ruta absoluta; en Windows se aceptan barras / (ej.: C:/Users/tu-usuario/Downloads/prod-ca-2021.crt).
# DATABASE_CA_CERT_FILE=C:/ruta/al/certificado.crt
DATABASE_POOL_MAX=5
SESSION_COOKIE_NAME=pt_session
SESSION_HOURS=8
JOOBLE_PE_API_KEY=
TRUST_PROXY=false
