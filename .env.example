NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=PostulaTrack
SQLSERVER_USER=PostulaTrackApp
SQLSERVER_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERTIFICATE=true
SESSION_COOKIE_NAME=pt_session
SESSION_HOURS=8
# Clave regional opcional para búsqueda de ofertas en Perú (pe.jooble.org).
# Sin clave, /api/jobs responde 503 y el resto del producto funciona.
JOOBLE_PE_API_KEY=
# Habilitar únicamente detrás de un proxy propio que reescribe X-Forwarded-For.
TRUST_PROXY=false
